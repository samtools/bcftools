sites_ref_only	0	# sites skipped because there was no ALT allele
sites_many_als	0	# skipped because of too many ALT alleles
sites_fail	0	# skipped because of failed -i/-e filter
sites_no_GT	0	# skipped because of absent FORMAT/GT field
sites_not_diploid	0	# skipped because FORMAT/GT not formatted diploid
sites_no_rule	3	# number of sites with no applicable inheritance rule in at least one trio
sites_missing	7	# number of sites with missing or unusable GT information in at least one trio
sites_merr	10	# number of sites with at least one definite Mendelian error
sites_good	12	# number of sites with at least one evaluable and Mendelian-consistent trio
ngood	12
ngood_alt	11
nmerr	10
nmissing	7
nfail	0
nno_rule	3
